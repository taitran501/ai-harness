# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
env/
venv/
ENV/

# Testing and caching
.pytest_cache/
.coverage
htmlcov/
tmp/
scratch/
.ipynb_checkpoints/

# Node & Frontend dependencies
node_modules/
dashboard/node_modules/
dashboard/dist/
*.local
pnpm-debug.log*

# Heavy model artifacts and weights
*.pt
*.bin
*.safetensors
*.onnx
checkpoints/

# Transient experiment caches and candidates
artifacts/agent_runs/
artifacts/agent_sessions/
artifacts/cand_*/
artifacts/base/
catboost_info/

# Local task state does not belong to the installable runtime distribution
/.agents/
/artifacts/
/.ai-harness/
/submissions/

# Host-agent config + prompt pack, regenerated by `ai-harness attach`
# (write_host_hooks / initialize_prompt_pack). Not source; do not track.
/.claude/
/.cursor/
/prompts/
/build/
/ai_harness.egg-info/
/task_plugins/*/build/
/task_plugins/*.egg-info/
/task_plugins/*/*.egg-info/
/splits/fold_assignments.tsv

# Agent-generated experiment configs (all except the template)
configs/exp[0-9][0-9][0-9]_*.yaml
!configs/exp000_template.yaml

# OS & Environment
Thumbs.db
.DS_Store
.env
.env.*
.gemini/
.pi/
harness/.model_names_cache.json
