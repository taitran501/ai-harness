{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-harness:reconciliation-report:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reconciliation_id",
    "competition",
    "provider",
    "provider_submissions_count",
    "accounted_submissions_count",
    "unexplained_submissions",
    "status",
    "checked_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reconciliation_id": {
      "type": "string"
    },
    "competition": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "provider_submissions_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "accounted_submissions_count": {
      "type": "integer",
      "minimum": 0
    },
    "unexplained_submissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "date", "description", "file_name"],
        "properties": {
          "ref": { "type": ["string", "integer"] },
          "date": { "type": "string" },
          "description": { "type": "string" },
          "file_name": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["CLEAN", "DISCREPANCY_DETECTED", "UNEXPLAINED_EXTERNAL_DISPATCH", "UNKNOWN"]
    },
    "reason_code": {
      "type": "string"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
