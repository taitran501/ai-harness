{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-harness:submission-gate-receipt:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "phase",
    "purpose",
    "status",
    "workspace_id",
    "task_id",
    "competition",
    "session_id",
    "policy_sha256",
    "comparison_identity_sha256",
    "payload",
    "prediction_sha256",
    "evidence_sha256",
    "decision_evaluation_ids",
    "diversity",
    "history_snapshot_sha256",
    "approval",
    "stagnation_state_sha256",
    "quota_snapshot",
    "checks",
    "reason_codes",
    "created_at",
    "expires_at",
    "framework_commit",
    "citation_admission",
    "citation_dependencies",
    "citation_claims"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "prepare",
        "dispatch"
      ]
    },
    "purpose": {
      "enum": [
        "initial",
        "promotion"
      ]
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "competition": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "comparison_identity_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256",
        "bytes",
        "filename",
        "kernel",
        "kernel_version",
        "output_binding"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "kernel_output"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "kernel": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "kernel_version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "output_binding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        }
      }
    },
    "prediction_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision_evaluation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diversity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "check",
        "status",
        "metric",
        "max_spearman",
        "hard_label_min_disagreement",
        "candidate_prediction_sha256",
        "comparison_identity_sha256",
        "history_snapshot_sha256",
        "identity_columns",
        "prediction_columns",
        "rows",
        "reference_count",
        "comparisons",
        "nearest_reference_id",
        "maximum_similarity",
        "reason_codes",
        "computed_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "check": {
          "const": "prediction_diversity"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "metric": {
          "enum": [
            "spearman",
            "exact_disagreement",
            "mixed",
            "none"
          ]
        },
        "max_spearman": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.995
        },
        "hard_label_min_disagreement": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "candidate_prediction_sha256": {
          "$ref": "#/$defs/hash"
        },
        "comparison_identity_sha256": {
          "$ref": "#/$defs/hash"
        },
        "history_snapshot_sha256": {
          "$ref": "#/$defs/hash"
        },
        "identity_columns": {
          "$ref": "#/$defs/columns"
        },
        "prediction_columns": {
          "$ref": "#/$defs/columns"
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "reference_count": {
          "type": "integer",
          "minimum": 0
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comparison"
          }
        },
        "nearest_reference_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "maximum_similarity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "RANK_SIMILARITY_EXCEEDS_LIMIT",
              "DISAGREEMENT_BELOW_LIMIT",
              "SEMANTIC_DUPLICATE",
              "UNDEFINED_CORRELATION",
              "INSUFFICIENT_ROWS",
              "IDENTITY_MISMATCH",
              "SCHEMA_MISMATCH",
              "NONFINITE_PREDICTION",
              "HISTORY_INCOMPLETE",
              "UNSUPPORTED_REPRESENTATION",
              "INITIAL_PORTFOLIO"
            ]
          }
        },
        "computed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "history_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "action",
            "subject_sha256",
            "actor",
            "time"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "const": "dispatch"
            },
            "subject_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "time": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+]00:00)$"
            }
          }
        }
      ]
    },
    "stagnation_state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "quota_snapshot": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "limit",
            "used",
            "reserved",
            "observed_at",
            "source"
          ],
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1
            },
            "used": {
              "type": "integer",
              "minimum": 0
            },
            "reserved": {
              "type": "integer",
              "minimum": 0
            },
            "observed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+]00:00)$"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "pass",
          "fail",
          "inconclusive",
          "not_required"
        ]
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+]00:00)$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+]00:00)$"
    },
    "framework_commit": {
      "type": "string",
      "minLength": 1
    },
    "citation_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "admission",
        "reason",
        "receipt_digests"
      ],
      "properties": {
        "status": {
          "enum": [
            "allowed",
            "blocked",
            "error",
            "not_applicable"
          ]
        },
        "admission": {
          "enum": [
            "allowed",
            "blocked",
            "error",
            "not_applicable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipt_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "action": {
          "type": "string"
        }
      }
    },
    "citation_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "citation_claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "diverse",
        "near_duplicate",
        "not_applicable",
        "inconclusive"
      ]
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "columnResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "method",
        "value",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "spearman",
            "exact_disagreement"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "exact_disagreement"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "diverse",
                  "near_duplicate"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "reference_prediction_sha256",
        "source",
        "rows",
        "columns",
        "status"
      ],
      "properties": {
        "reference_id": {
          "type": "string",
          "minLength": 1
        },
        "reference_prediction_sha256": {
          "$ref": "#/$defs/hash"
        },
        "source": {
          "enum": [
            "incumbent",
            "dispatched",
            "prepared"
          ]
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/columnResult"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    }
  }
}
