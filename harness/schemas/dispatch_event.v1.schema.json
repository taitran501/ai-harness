{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-harness:dispatch-event:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "intent_id",
    "event",
    "payload_sha256",
    "prediction_sha256",
    "history_snapshot_sha256",
    "competition",
    "session_id",
    "receipt_id",
    "timestamp",
    "provider_ref",
    "error_code"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "enum": [
        "prepared",
        "sending",
        "submitted",
        "rejected",
        "failed",
        "unknown",
        "reconciled"
      ]
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prediction_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "history_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "competition": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+]00:00)$"
    },
    "provider_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": [
            "string",
            "integer"
          ]
        }
      ]
    },
    "error_code": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  }
}
